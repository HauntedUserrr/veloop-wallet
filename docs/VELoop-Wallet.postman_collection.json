              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/wallet/debit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"currency\": \"ves\",\n  \"amount\": 500,\n  \"referenceId\": \"{{$guid}}\",\n  \"description\": \"Demo adjustment\",\n  \"source\": \"ADMIN_DEBIT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Post exchange",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
