              }
            ],
            "url": "{{baseUrl}}/api/admin/withdrawals/{{withdrawalId}}/audit",
            "description": "Inspect the review timeline and private reviewer notes for the captured withdrawal."
          }
        }
      ]
    },
    {
      "name": "Reject a pending withdrawal",
      "description": "Use a fresh demo withdrawal and a signed-in administrator. Run this folder for the reversal path.",
      "item": [
        {
          "name": "Reject withdrawal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/withdrawals/{{withdrawalId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"reason\": \"Demo rejection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Approve a pending withdrawal",
      "description": "Use a fresh demo withdrawal and a signed-in administrator. This path preserves the original debit.",
      "item": [
        {
          "name": "Mark processing",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/withdrawals/{{withdrawalId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve processing withdrawal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/withdrawals/{{withdrawalId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Payout catalog",
      "description": "Fill in the request bodies and IDs as Postman environment variables before sending any of these requests. Use confirmed denominations and destination fields.",
      "item": [
        {
          "name": "Add payout option",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payout/options",
            "body": {
              "mode": "raw",
              "raw": "{{catalogOptionBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update payout option",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payout/options/{{catalogOptionId}}",
            "body": {
              "mode": "raw",
              "raw": "{{catalogOptionPatch}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Configure payout method",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payout/methods/{{catalogMethodId}}",
            "body": {
              "mode": "raw",
              "raw": "{{catalogMethodBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Optional evaluator and browser intent",
      "description": "Run requests individually. Start an evaluator demo only if the server has a configured code. Otherwise use Start demo in Authentication. Prepare and then discard a browser intent to verify that the quote is bound without debiting the wallet. The direct API workflow uses its own withdrawal key.",
      "item": [
        {
          "name": "Start evaluator demo",
          "request": {
            "description": "Set evaluatorAccessCode to the server-issued code in a private Postman environment before sending.",
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/demo/evaluator",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accessCode = pm.environment.get('evaluatorAccessCode');",
                  "if (!accessCode) throw new Error('Set evaluatorAccessCode in a private Postman environment.');",
                  "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ accessCode }) });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);",
                  "const session = pm.response.json();",
                  "pm.collectionVariables.set('userToken', session.token);",
                  "pm.collectionVariables.set('userId', session.user.id);",
                  "pm.collectionVariables.set('withdrawalKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prepare browser withdrawal",
          "request": {
            "description": "Generates a new browser key and binds it to this sample UPI quote. Discard the intent before preparing another in this example.",
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{browserWithdrawalKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals/intents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_100\",\n  \"payoutDetail\": \"demo@sample\",\n  \"expectedRequiredAmount\": 19500,\n  \"expectedPayoutMinor\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = 'wd1-' + Date.now() + '-' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('browserWithdrawalKey', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().prepared).to.equal(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Discard browser withdrawal",
          "request": {
            "description": "Uses the prepared browser key. Run this after Prepare browser withdrawal without submitting a debit.",
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{browserWithdrawalKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals/intents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().abandoned).to.equal(true);",
                  "pm.collectionVariables.unset('browserWithdrawalKey');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sign-out",
      "item": [
        {
          "name": "End demo session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    }
  ]
}
