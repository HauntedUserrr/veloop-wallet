{
  "info": {
    "name": "VELoop Rewards Wallet",
    "description": "Local wallet demo. Start a fresh demo to populate its token, ID, and withdrawal key. Set ADMIN_EMAIL and ADMIN_PASSWORD when seeding to try admin requests. Enter administrator credentials as private environment variables in Postman. Run the approval and rejection folders against separate demo withdrawals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "withdrawalKey",
      "value": ""
    },
    {
      "key": "browserWithdrawalKey",
      "value": ""
    },
    {
      "key": "withdrawalId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Start demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/demo",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);",
                  "const session = pm.response.json();",
                  "pm.collectionVariables.set('userToken', session.token);",
                  "pm.collectionVariables.set('userId', session.user.id);",
                  "pm.collectionVariables.set('withdrawalKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Administrator login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{{adminLoginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.get('adminEmail');",
                  "const password = pm.variables.get('adminPassword');",
                  "if (!email || !password) throw new Error('Set adminEmail and adminPassword before signing in.');",
                  "pm.variables.set('adminLoginBody', JSON.stringify({ email, password }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet"
          }
        },
        {
          "name": "Get summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet/summary?page=1&limit=6"
          }
        },
        {
          "name": "Get wallet transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet/transactions?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Payout and withdrawals",
      "item": [
        {
          "name": "Payout methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/payout/methods"
          }
        },
        {
          "name": "All payout options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/payout/options"
          }
        },
        {
          "name": "UPI options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/payout/options/upi"
          }
        },
        {
          "name": "Submit withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{withdrawalKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_100\",\n  \"payoutDetail\": \"demo@sample\",\n  \"expectedRequiredAmount\": 19500,\n  \"expectedPayoutMinor\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "pm.collectionVariables.set('withdrawalId', pm.response.json().withdrawal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry same withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{withdrawalKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_100\",\n  \"payoutDetail\": \"demo@sample\",\n  \"expectedRequiredAmount\": 19500,\n  \"expectedPayoutMinor\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().withdrawal.id).to.equal(pm.collectionVariables.get('withdrawalId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my withdrawals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals"
          }
        },
        {
          "name": "Recover receipt by request key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{withdrawalKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals/attempt"
          }
        },
        {
          "name": "Get my withdrawal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/withdrawals/{{withdrawalId}}"
          }
        }
      ]
    },
    {
      "name": "Admin operations",
      "item": [
        {
          "name": "Credit wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/wallet/credit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"currency\": \"ves\",\n  \"amount\": 500,\n  \"referenceId\": \"{{$guid}}\",\n  \"description\": \"Demo adjustment\",\n  \"source\": \"ADMIN_CREDIT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Debit wallet",
          "request": {
            "method": "POST",
            "header": [
              {
