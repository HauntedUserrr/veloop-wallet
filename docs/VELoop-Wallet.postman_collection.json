            ],
            "url": "{{baseUrl}}/api/wallet/exchange",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"fromCurrency\": \"gems\",\n  \"fromAmount\": 10,\n  \"toCurrency\": \"ves\",\n  \"toAmount\": 100,\n  \"referenceId\": \"{{$guid}}\",\n  \"description\": \"Demo exchange\"\n}",
              "options": {
