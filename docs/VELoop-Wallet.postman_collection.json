              }
            ],
            "url": "{{baseUrl}}/api/admin/wallet/{{userId}}/reconciliation",
            "description": "Compare the demo wallet with posted ledger totals. A nonzero difference reports drift without changing the wallet."
          }
        },
        {
          "name": "Get withdrawal review history",
          "request": {
            "method": "GET",
            "header": [
